{
  "name": "school-result-processing-system",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter @school-result/api --filter @school-result/web dev",
    "dev:api": "pnpm --filter @school-result/api dev",
    "dev:web": "pnpm --filter @school-result/web dev",
    "build": "pnpm --filter @school-result/shared build && pnpm --filter @school-result/api db:generate && pnpm --filter @school-result/api build && pnpm --filter @school-result/web build",
    "test": "pnpm --filter @school-result/api test",
    "test:unit": "pnpm --filter @school-result/api test:unit",
    "test:api": "pnpm --filter @school-result/api test:api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @school-result/api db:migrate",
    "db:generate": "pnpm --filter @school-result/api db:generate",
    "db:seed": "pnpm --filter @school-result/api db:seed",
    "db:self-check": "pnpm --filter @school-result/api db:self-check",
    "lint": "pnpm --filter @school-result/api lint"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@10.29.3"
}
